#!/bin/bash
# Usage: smoke-test <judge dir> <image>
# Runs the C judge in the image the way Dodona's submission runner does: once
# per golden case of the judge's own tests/, then once per kind of failing
# submission, and asserts on its JSON. DOCKER_PLATFORM overrides the platform.
set -u

if [ $# -ne 2 ]; then
  echo "Usage: $0 <judge dir> <image>" >&2
  exit 2
fi

judge=$(cd "$1" && pwd)
image=$2
here=$(cd "$(dirname "$0")" && pwd)
failures=0

# macOS has no timeout binary; the ${tmo[@]+...} expansion keeps bash 3.2 happy under set -u.
tmo=()
if command -v timeout >/dev/null; then
  tmo=(timeout 60)
elif command -v gtimeout >/dev/null; then
  tmo=(gtimeout 60)
fi

# Prints the config Dodona sends: runner defaults, then the mounted paths.
build_config() {
  jq -n \
    '{memory_limit: 256000000, time_limit: 42, network_enabled: false,
      programming_language: "c",
      natural_language: "en",
      resources: "/mnt/hidden/resources",
      source: "/mnt/hidden/submission/source",
      judge: "/mnt/hidden/judge",
      workdir: "/home/runner/workdir"}'
}

# run_judge <evaluation dir> <submission file>: prints the judge's stdout.
run_judge() {
  local evaluation=$1 source=$2 tmp config
  tmp=$(mktemp -d)
  mkdir -p "$tmp/workdir" "$tmp/hidden/submission" "$tmp/hidden/resources"
  cp "$source" "$tmp/hidden/submission/source"
  cp -R "$evaluation/." "$tmp/hidden/resources/"
  cp -R "$judge" "$tmp/hidden/judge"
  # The container's runner user has another uid than the host user.
  chmod -R a+rX "$tmp"
  chmod 777 "$tmp/workdir"

  config=$(build_config)
  if [ -n "${DRY_RUN:-}" ]; then
    echo "$config"
    rm -rf "$tmp"
    return
  fi

  echo "$config" | ${tmo[@]+"${tmo[@]}"} docker run --rm -i \
    ${DOCKER_PLATFORM:+--platform "$DOCKER_PLATFORM"} \
    --memory "$(jq .memory_limit <<<"$config")" \
    --pids-limit 256 \
    --network none \
    -v "$tmp:/mnt" \
    -v "$tmp/workdir:/home/runner/workdir" \
    "$image" /main.sh /mnt/hidden/judge/run 2>"$tmp/stderr.log" \
    || echo "container exited with status $?" >>"$tmp/stderr.log"
  sed 's/^/stderr: /' "$tmp/stderr.log" >&2
  rm -rf "$tmp"
}

# golden <case dir>: the judge's stdout must equal the case's expected file.
golden() {
  local case=$1 name output delta
  name=$(basename "$case")
  output=$(run_judge "$case/test_cases" "$case/source.c")
  if [ -n "${DRY_RUN:-}" ]; then
    echo "== $name"
    echo "$output"
    return
  fi
  # The judge's parse_*.py emit indented JSON, so compare normalised JSON.
  if delta=$(diff <(jq -S . <<<"$output" 2>&1) <(jq -S . "$case/expected")); then
    echo "PASS $name: matches the judge's expected feedback"
  else
    echo "FAIL $name: differs from the judge's expected feedback"
    echo "  | ${delta//$'\n'/$'\n'  | }"
    failures=$((failures + 1))
  fi
}

# check <name> <evaluation dir> <submission file> <jq filter>
check() {
  local name=$1 evaluation=$2 source=$3 filter=$4 output
  output=$(run_judge "$evaluation" "$source")
  if [ -n "${DRY_RUN:-}" ]; then
    echo "== $name"
    echo "$output"
    return
  fi
  if jq -e "$filter" >/dev/null 2>&1 <<<"$output"; then
    echo "PASS $name"
  else
    echo "FAIL $name (expected: $filter)"
    echo "  | ${output//$'\n'/$'\n'  | }"
    failures=$((failures + 1))
  fi
}

for case in "$judge"/tests/*/; do
  golden "${case%/}"
done

exercise=fact_single_correct
evaluation=$judge/tests/$exercise/test_cases
check "$exercise: wrong solution is rejected" "$evaluation" \
  "$here/submissions/$exercise/wrong.c" '.accepted == false'
check "$exercise: submission that does not compile is a compilation error" "$evaluation" \
  "$here/submissions/$exercise/broken.c" '.accepted == false and .status == "compilation error"'
check "$exercise: submission that crashes is a runtime error" "$evaluation" \
  "$here/submissions/$exercise/crash.c" '.accepted == false and .status == "runtime error"'

if [ "$failures" -ne 0 ]; then
  echo "$failures case(s) failed"
  exit 1
fi
