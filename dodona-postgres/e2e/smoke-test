#!/bin/bash
# Usage: smoke-test <judge dir> <image>
# Runs the PostgreSQL judge in the image the way Dodona's submission runner does,
# against a throwaway PostgreSQL server, once per exercise and kind of
# submission, and asserts on the final status Dodona would compute from its JSON.
set -u

if [ $# -ne 2 ]; then
  echo "Usage: $0 <judge dir> <image>" >&2
  exit 2
fi

postgres_image=postgres:17-alpine

judge=$(cd "$1" && pwd)
image=$2
here=$(cd "$(dirname "$0")" && pwd)
failures=0
network=pgjudge-e2e-$$
db_container=$network-db

cleanup() {
  docker rm -f "$db_container" >/dev/null 2>&1
  docker network rm "$network" >/dev/null 2>&1
}

start_database() {
  docker network create "$network" >/dev/null || exit 2
  trap cleanup EXIT
  docker run -d --name "$db_container" --network "$network" --network-alias pg \
    -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=shop \
    -v "$here/schema.sql:/docker-entrypoint-initdb.d/schema.sql:ro" \
    "$postgres_image" >/dev/null || exit 2
  # The init phase serves on the unix socket only, so probe over TCP.
  for _ in $(seq 60); do
    docker exec "$db_container" pg_isready -h 127.0.0.1 -U postgres -d shop >/dev/null 2>&1 && return
    sleep 1
  done
  echo "PostgreSQL did not accept connections in time" >&2
  docker logs "$db_container" >&2
  exit 2
}

# build_config <exercise dir> <natural language>: prints the config Dodona
# sends: runner defaults, then the exercise's merged dirconfig.json (its parent
# directory's) and config.json evaluation settings, then the mounted paths.
build_config() {
  local exercise=$1 language=$2
  jq -n \
    --arg language "$language" \
    --slurpfile dir "$(dirname "$exercise")/dirconfig.json" \
    --slurpfile own "$exercise/config.json" \
    '{memory_limit: 256000000, time_limit: 42, network_enabled: false}
     * (($dir[0] * $own[0]).evaluation // {})
     * {programming_language: "postgresql",
        natural_language: $language,
        resources: "/mnt/hidden/resources",
        source: "/mnt/hidden/submission/source",
        judge: "/mnt/hidden/judge",
        workdir: "/home/runner/workdir"}'
}

# run_judge <exercise dir> <submission file> <natural language>: prints the judge's stdout.
run_judge() {
  local exercise=$1 source=$2 language=$3 tmp config network_args limit=
  # macOS has no timeout(1).
  ! command -v timeout >/dev/null || limit="timeout 120"
  tmp=$(mktemp -d)
  mkdir -p "$tmp/workdir" "$tmp/hidden/submission" "$tmp/hidden/resources"
  cp "$source" "$tmp/hidden/submission/source"
  cp -R "$exercise/evaluation/." "$tmp/hidden/resources/"
  cp -R "$judge" "$tmp/hidden/judge"
  # The container's runner user has another uid than the host user.
  chmod -R a+rX "$tmp"
  chmod 777 "$tmp/workdir"

  config=$(build_config "$exercise" "$language")
  if [ -n "${DRY_RUN:-}" ]; then
    echo "$config"
    rm -rf "$tmp"
    return
  fi

  network_args=(--network none)
  if [ "$(jq .network_enabled <<<"$config")" = true ]; then
    network_args=(--network "$network")
  fi

  echo "$config" | $limit docker run --rm -i \
    --platform linux/amd64 \
    --memory "$(jq .memory_limit <<<"$config")" \
    --pids-limit 256 \
    "${network_args[@]}" \
    -v "$tmp:/mnt" \
    -v "$tmp/workdir:/home/runner/workdir" \
    "$image" /main.sh /mnt/hidden/judge/run 2>"$tmp/stderr.log" \
    || echo "container exited with status $?" >>"$tmp/stderr.log"
  sed 's/^/stderr: /' "$tmp/stderr.log" >&2
  rm -rf "$tmp"
}

# Prints the status Dodona ends up with: the worst close-test status, unless close-judgement sets one.
final_status() {
  jq -rs '
    ["correct", "wrong", "runtime error", "compilation error",
     "memory limit exceeded", "time limit exceeded", "internal error"] as $order
    | ([.[] | select(.command == "close-test") | .status.enum] | map(. as $s | $order | index($s)) | max // 0) as $worst
    | ([.[] | select(.command == "close-judgement")] | last) as $close
    | if $close.status.enum then $close.status.enum
      else $order[$worst] end
  ' <<<"$1"
}

# valid_stream <output>: JSON objects only, ending in a close-judgement, no internal error.
valid_stream() {
  jq -es '
    length > 0 and all(type == "object")
    and any(.[]; .command == "close-judgement")
    and (map(tostring) | all(contains("internal error") | not))
  ' <<<"$1" >/dev/null 2>&1
}

# check <name> <exercise> <submission> <expected status> [natural language]
check() {
  local name=$1 exercise=$here/exercises/$2 source=$3 expected=$4 language=${5:-en} output actual
  output=$(run_judge "$exercise" "$source" "$language")
  if [ -n "${DRY_RUN:-}" ]; then
    echo "== $name"
    echo "$output"
    return
  fi
  if ! valid_stream "$output"; then
    echo "FAIL $name (output is not a valid judge stream)"
    echo "  | ${output//$'\n'/$'\n'  | }"
    failures=$((failures + 1))
    return
  fi
  actual=$(final_status "$output")
  if [ "$actual" = "$expected" ]; then
    echo "PASS $name"
  else
    echo "FAIL $name (expected: $expected, got: $actual)"
    echo "  | ${output//$'\n'/$'\n'  | }"
    failures=$((failures + 1))
  fi
}

[ -n "${DRY_RUN:-}" ] || start_database

sub=$here/submissions
sol() { echo "$here/exercises/$1/evaluation/solution.sql"; }

check "filter: reference solution is accepted" filter "$(sol filter)" correct
check "filter: rows that differ are wrong" filter "$sub/filter/wrong-rows.sql" wrong
check "filter: rows in the wrong order are wrong" filter "$sub/filter/wrong-order.sql" wrong
check "filter: a missing column is wrong" filter "$sub/filter/missing-column.sql" wrong
check "filter: a syntax error is a compilation error" filter "$sub/filter/syntax-error.sql" "compilation error"
check "filter: a DELETE is wrong" filter "$sub/filter/delete.sql" wrong
check "filter: two statements are wrong" filter "$sub/filter/two-statements.sql" wrong

check "unordered: reference solution is accepted" unordered "$(sol unordered)" correct
check "unordered: another row order is accepted" unordered "$sub/unordered/other-order.sql" correct
check "unordered: rows that differ are wrong" unordered "$sub/unordered/wrong-rows.sql" wrong

check "types: reference solution is accepted" types "$(sol types)" correct
check "types: a wrong interval is wrong" types "$sub/types/wrong-interval.sql" wrong
check "types: a wrong array is wrong" types "$sub/types/wrong-array.sql" wrong
check "types: a wrong date is wrong" types "$sub/types/wrong-date.sql" wrong
check "types: a value where NULL is expected is wrong" types "$sub/types/wrong-null.sql" wrong

for exercise in "$here"/exercises/*/; do
  name=$(basename "$exercise")
  check "$name: reference solution is accepted in Dutch" "$name" "$(sol "$name")" correct nl
done

if [ "$failures" -ne 0 ]; then
  echo "$failures case(s) failed"
  exit 1
fi
